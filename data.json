    "polyglot": {
      "theme": "현재 위치 (Q&A)",
      "type": "기초",
      "meaning": "Q: 여기가 어디인가요? / A: 지하철역 바로 앞입니다.",
      "translations": {
        "en": {
          "code": "en-US",
          "name": "영어",
          "flag": "🇺🇸",
          "text": "Where are we right now? - Right in front of the subway station.",
          "roman": "웨어 아 위 라이트 나우? - 라이트 인 프런트 오브 더 서브웨이 스테이션."
        },
        "ja": {
          "code": "ja-JP",
          "name": "일본어",
          "flag": "🇯🇵",
          "text": "ここはどこですか？ - 地下鉄の駅のすぐ前です。",
          "roman": "코코와 도코 데스 카? - 치카테츠노 에키노 스구 마에 데스."
        },
        "zh": {
          "code": "zh-CN",
          "name": "중국어",
          "flag": "🇨🇳",
          "text": "请问这里是哪里？ - 就在地铁站的正前方。",
          "roman": "칭원 저리 스 나리? - 지우 짜이 디톄잔 더 정 첸팡."
        },
        "fr": {
          "code": "fr-FR",
          "name": "프랑스어",
          "flag": "🇫🇷",
          "text": "Où sommes-nous ? - Juste devant la station de métro.",
          "roman": "우 쏨 누? - 쥐스트 드방 라 스타시옹 드 메트로."
        },
        "de": {
          "code": "de-DE",
          "name": "독일어",
          "flag": "🇩🇪",
          "text": "Wo sind wir hier? - Direkt vor der U-Bahn-Station.",
          "roman": "보 진트 비어 히어? - 디렉트 포어 데어 우-반-슈타치온."
        },
        "es": {
          "code": "es-ES",
          "name": "스페인어",
          "flag": "🇪🇸",
          "text": "¿Dónde estamos ahora? - Justo frente a la estación de metro.",
          "roman": "돈데 에스따모스 아오라? - 후스토 프렌테 아 라 에스타시온 데 메트로."
        },
        "ar": {
          "code": "ar-SA",
          "name": "아랍어",
          "flag": "🇸🇦",
          "text": "أين نحن الآن؟ - أمام محطة المترو مباشرة.",
          "roman": "아이나 나흐눌 안? - 아마마 마핫타틸 미트루 무바샤라탄."
        },
        "ru": {
          "code": "ru-RU",
          "name": "러시아어",
          "flag": "🇷🇺",
          "text": "Где мы сейчас? - Прямо перед станцией метро.",
          "roman": "그제 믜 시차스? - 쁘랴마 뻬렛 스딴치예이 메트로."
