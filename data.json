    "polyglot": {
      "theme": "물품 요청 (Q&A)",
      "type": "기초",
      "meaning": "Q: 물 한 잔 주시겠어요? / A: 네, 여기 있습니다.",
      "translations": {
        "en": {
          "code": "en-US",
          "name": "영어",
          "flag": "🇺🇸",
          "text": "May I have a glass of water, please? - Sure, here you go.",
          "roman": "메이 아이 해브 어 글래스 오브 워터, 플리즈? - 슈어, 히어 유 고."
        },
        "ja": {
          "code": "ja-JP",
          "name": "일본어",
          "flag": "🇯🇵",
          "text": "お水を一杯いただけますか？ - はい、どうぞ。",
          "roman": "오미즈오 잇파이 이타다케마스 카? - 하이, 도-조."
        },
        "zh": {
          "code": "zh-CN",
          "name": "중국어",
          "flag": "🇨🇳",
          "text": "可以给我一杯水吗？ - 好的，请用。",
          "roman": "커이 게이 워 이베이 슈이 마? - 하오 더, 칭 융."
        },
        "fr": {
          "code": "fr-FR",
          "name": "프랑스어",
          "flag": "🇫🇷",
          "text": "Puis-je avoir un verre d'eau, s'il vous plaît ? - Bien sûr, voici.",
          "roman": "퓌이-즈 아부아 앙 베르 도, 실 부 플레? - 비앙 쉬르, 부아시."
        },
        "de": {
          "code": "de-DE",
          "name": "독일어",
          "flag": "🇩🇪",
          "text": "Könnte ich bitte ein Glas Wasser haben? - Sicher, bitte sehr.",
          "roman": "켠테 이히 비테 아인 글라스 바서 하벤? - 지허, 비테 제어."
        },
        "es": {
          "code": "es-ES",
          "name": "스페인어",
          "flag": "🇪🇸",
          "text": "¿Me da un vaso de agua, por favor? - Claro, aquí tiene.",
          "roman": "메 다 운 바소 데 아구아, 뽀르 파보르? - 클라로, 아키 티에네."
        },
        "ar": {
          "code": "ar-SA",
          "name": "아랍어",
          "flag": "🇸🇦",
          "text": "هل يمكنني الحصول على كوب ماء؟ - بالطبع، تفضل.",
          "roman": "할 윰키누닐 후술 알라 쿠비 마? - 빗탑으, 타팟달."
        },
        "ru": {
          "code": "ru-RU",
          "name": "러시아어",
          "flag": "🇷🇺",
          "text": "Можно стакан воды, пожалуйста? - Конечно, вот, держите.",
          "roman": "모즈나 스타칸 바듸, 빠잘루이스타? - 카녜시나, 보트, 제르지쩨."
        }
      },
      "pool_type": "기초",
      "d_day": "오늘"
    },
