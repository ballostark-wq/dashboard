        "type": "기초",
        "meaning": "Q: 물 한 잔 주시겠어요? / A: 네, 여기 있습니다.",
        "translations": {
          "en": {
            "code": "en-US",
            "name": "영어",
            "flag": "🇺🇸",
            "text": "May I have a glass of water, please? - Sure, here you go.",
            "roman": "메이 아이 해브 어 글래스 오브 워터, 플리즈? - 슈어, 히어 유 고."
          },
          "ja": {
            "code": "ja-JP",
            "name": "일본어",
            "flag": "🇯🇵",
            "text": "お水を一杯いただけますか？ - はい、どうぞ。",
            "roman": "오미즈오 잇파이 이타다케마스 카? - 하이, 도-조."
          },
          "zh": {
            "code": "zh-CN",
            "name": "중국어",
            "flag": "🇨🇳",
            "text": "可以给我一杯水吗？ - 好的，请用。",
            "roman": "커이 게이 워 이베이 슈이 마? - 하오 더, 칭 융."
          },
          "fr": {
            "code": "fr-FR",
            "name": "프랑스어",
            "flag": "🇫🇷",
            "text": "Puis-je avoir un verre d'eau, s'il vous plaît ? - Bien sûr, voici.",
            "roman": "퓌이-즈 아부아 앙 베르 도, 실 부 플레? - 비앙 쉬르, 부아시."
          },
          "de": {
            "code": "de-DE",
            "name": "독일어",
