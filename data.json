          "name": "스페인어",
          "flag": "🇪🇸",
          "text": "¿Podría hablar un poco más despacio, por favor?",
          "roman": "뽀드리아 아블라르 운 뽀꼬 마스 데스파시오, 뽀르 파보르?"
        },
        "ar": {
          "code": "ar-SA",
          "name": "아랍어",
          "flag": "🇸🇦",
          "text": "هل يمكنك التحدث ببطء أكثر من فضلك؟",
          "roman": "할 윰키누카 앗타핫두스 비부틴 악사르 민 파들릭?"
        },
        "ru": {
          "code": "ru-RU",
          "name": "러시아어",
          "flag": "🇷🇺",
          "text": "Говорите, пожалуйста, помедленнее.",
          "roman": "가바리쩨, 빠잘루이스타, 빠메들린녜예."
        }
      },
