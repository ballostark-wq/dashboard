      "theme": "소통 배려",
      "type": "기초",
      "meaning": "조금만 천천히 말씀해 주시겠어요?",
      "translations": {
        "en": {
          "code": "en-US",
          "name": "영어",
          "flag": "🇺🇸",
          "text": "Could you speak a little more slowly, please?",
          "roman": "쿠쥬 스픽 어 리틀 모어 슬로우리, 플리즈?"
        },
        "ja": {
          "code": "ja-JP",
          "name": "일본어",
          "flag": "🇯🇵",
          "text": "もう少しゆっくり話していただけますか？",
          "roman": "모- 스코시 윳쿠리 하나시테 이타다케마스 카?"
        },
        "zh": {
          "code": "zh-CN",
          "name": "중국어",
          "flag": "🇨🇳",
          "text": "请你说得稍微慢一点好吗？",
          "roman": "칭 니 슈오 더 샤오웨이 만 이디엔 하오 마?"
        },
        "fr": {
          "code": "fr-FR",
          "name": "프랑스어",
          "flag": "🇫🇷",
          "text": "Pourriez-vous parler un peu plus lentement ?",
          "roman": "푸리에 부 파를레 앙 쁘 플뤼 랑트망?"
        },
        "de": {
          "code": "de-DE",
          "name": "독일어",
          "flag": "🇩🇪",
          "text": "Könnten Sie bitte etwas langsamer sprechen?",
          "roman": "켠텐 지 비테 에트바스 랑자머 슈프레헨?"
        },
        "es": {
