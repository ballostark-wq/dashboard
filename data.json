      "theme": "위치 문의 (Q&A)",
      "type": "기초",
      "meaning": "Q: 화장실이 어디에 있나요? / A: 저기 오른쪽에 있어요.",
      "translations": {
        "en": {
          "code": "en-US",
          "name": "영어",
          "flag": "🇺🇸",
          "text": "Where is the restroom? - It's right over there on the right.",
          "roman": "웨어 이즈 더 레스트룸? - 잇츠 라이트 오버 데어 온 더 라이트."
        },
        "ja": {
          "code": "ja-JP",
          "name": "일본어",
          "flag": "🇯🇵",
          "text": "トイレはどこですか？ - あちらの右側にあります。",
          "roman": "토이레와 도코 데스 카? - 아치라노 미기가와니 아리마스."
        },
        "zh": {
          "code": "zh-CN",
          "name": "중국어",
          "flag": "🇨🇳",
          "text": "洗手间在哪里？ - 就在那边的右边。",
          "roman": "시쇼우지엔 짜이 나리? - 지우 짜이 나비엔 더 요우비엔."
        },
        "fr": {
          "code": "fr-FR",
          "name": "프랑스어",
          "flag": "🇫🇷",
          "text": "Où sont les toilettes ? - C'est juste là, sur la droite.",
          "roman": "우 쏭 레 뚜알레트? - 세 쥐스트 라, 쉬르 라 드루아트."
        },
        "de": {
          "code": "de-DE",
          "name": "독일어",
          "flag": "🇩🇪",
          "text": "Wo ist die Toilette? - Direkt dort drüben auf der rechten Seite.",
          "roman": "보 이스트 디 토일레테? - 디렉트 도르트 드뤼벤 아우프 데어 레히텐 자이테."
        },
        "es": {
          "code": "es-ES",
          "name": "스페인어",
          "flag": "🇪🇸",
          "text": "¿Dónde está el baño? - Está justo allí, a la derecha.",
          "roman": "돈데 에스따 엘 바뇨? - 에스따 후스토 아이, 아 라 데레차."
        },
        "ar": {
          "code": "ar-SA",
          "name": "아랍어",
          "flag": "🇸🇦",
          "text": "أين الحمام؟ - إنه هناك على اليمين مباشرة.",
          "roman": "아이날 함맘? - 인나후 후나카 알랄 야민 무바샤라탄."
        },
        "ru": {
          "code": "ru-RU",
          "name": "러시아어",
          "flag": "🇷🇺",
          "text": "Где находится туалет? - Вон там, прямо направо.",
          "roman": "그제 나호지차 뚜알례트? - 본 탐, 쁘랴마 나쁘라바."
