    "polyglot": {
      "theme": "준비 확인 (Q&A)",
      "type": "기초",
      "meaning": "Q: 지금 준비되셨나요? / A: 네, 다 준비됐어요. 바로 가요.",
      "translations": {
        "en": {
          "code": "en-US",
          "name": "영어",
          "flag": "🇺🇸",
          "text": "Are you ready now? - Yes, I'm all set. Let's go.",
          "roman": "아 유 레디 나우? - 예스, 아임 올 셋. 렛츠 고."
        },
        "ja": {
          "code": "ja-JP",
          "name": "일본어",
          "flag": "🇯🇵",
          "text": "準備はできましたか？ - はい、準備完了です。行きましょう。",
          "roman": "쥰비와 데키마시타 카? - 하이, 쥰비 칸료-데스. 이키마쇼-."
        },
        "zh": {
          "code": "zh-CN",
          "name": "중국어",
          "flag": "🇨🇳",
          "text": "你准备好了吗？ - 好了，都准备好了，走吧。",
          "roman": "니 준베이 하오 러 마? - 하오 러, 더우 준베이 하오 러, 저우 바."
        },
        "fr": {
          "code": "fr-FR",
          "name": "프랑스어",
          "flag": "🇫🇷",
          "text": "Êtes-vous prêt maintenant ? - Oui, je suis prêt. Allons-y.",
          "roman": "에트 부 프레 맹트낭? - 위, 즈 슈이 프레. 알롱-지."
        },
        "de": {
          "code": "de-DE",
          "name": "독일어",
          "flag": "🇩🇪",
          "text": "Sind Sie jetzt bereit? - Ja, alles bereit. Los geht's.",
          "roman": "진트 지 제츠트 베라이트? - 야, 알레스 베라이트. 로스 게츠."
        },
        "es": {
          "code": "es-ES",
          "name": "스페인어",
          "flag": "🇪🇸",
          "text": "¿Estás listo ahora? - Sí, estoy listo. Vamos.",
          "roman": "에스따스 리스토 아오라? - 시, 에스또이 리스토. 바모스."
        },
        "ar": {
          "code": "ar-SA",
          "name": "아랍어",
          "flag": "🇸🇦",
          "text": "هل أنت مستعد الآن؟ - نعم، أنا جاهز تماماً. هيا بنا.",
          "roman": "할 안타 무스타잇둔 알-안? - 나암, 아나 자히준 타마만. 하이야 비나."
        },
        "ru": {
          "code": "ru-RU",
          "name": "러시아어",
          "flag": "🇷🇺",
          "text": "Вы готовы? - Да, всё готово. Поехали.",
          "roman": "브이 가토븨? - 다, 프쇼 가토바. 빠예할리."
        }
      },
      "pool_type": "기초",
      "d_day": "오늘"
    },
